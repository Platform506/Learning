{
  "expo": {
    "name": "ESS Cuadratura",
    "slug": "ess",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ess",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ess.cuadratura",
      "infoPlist": {
        "NSCameraUsageDescription": "ESS necesita la cámara para fotografiar las tablas del papel.",
        "NSPhotoLibraryUsageDescription": "ESS necesita la galería para cargar fotos de las tablas."
      }
    },
    "android": {
      "package": "com.ess.cuadratura",
      "adaptiveIcon": {
        "backgroundColor": "#1b5e20",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ESS necesita acceso a tus fotos de tablas manuscritas.",
          "cameraPermission": "ESS necesita la cámara para fotografiar las tablas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-4000-8000-000000000001"
      }
    }
  }
}
